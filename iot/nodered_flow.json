        "wires": [
            ["fn_parse_sensores", "fn_alerta_suelo", "fn_alerta_temp", "c6ae2539031b30ab"]
        ]
    },
    {
        "id": "fn_parse_sensores",
        "type": "function",
        "z": "049787f649ebff4d",
        "name": "Actualizar contexto de flujo",
        "func": "// Actualiza las variables de contexto que usan los gates de control.\n// Los widgets reciben datos desde sus propios tópicos MQTT individuales.\nvar p = msg.payload;\nflow.set('modo',            p.modo            || 'AUTO');\nflow.set('temperatura',     p.temperatura);\nflow.set('humedad_suelo',   p.humedad_sustrato);\nflow.set('bomba_riego',     p.bomba_riego);\nflow.set('control_termico', p.control_termico);\nreturn null;",
        "outputs": 0,
        "x": 510,
        "y": 100,
        "wires": []
    },

