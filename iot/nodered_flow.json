    {
        "id": "fn_alerta_suelo",
        "type": "function",
        "z": "049787f649ebff4d",
        "name": "Evaluar alerta suelo seco",
        "func": "// Siempre retorna un mensaje para que el widget se actualice (OK o ALERTA).\n// Si retorna null cuando no hay alerta, el widget queda congelado mostrando\n// el ultimo mensaje de alerta para siempre.\nvar h = msg.payload.humedad_sustrato;\nif (h === null || h === undefined) {\n    return { payload: 'Sin datos del sensor de suelo' };\n}\nif (h < 20) {\n    return { payload: 'ALERTA: Suelo muy seco (' + h.toFixed(1) + '%). Revisar riego.' };\n}\nreturn { payload: 'OK: Humedad del suelo en rango (' + h.toFixed(1) + '%)' };",
        "outputs": 1,
        "x": 500,
        "y": 1060,
        "wires": [["txt_alerta_suelo"]]
    },
    {
        "id": "fn_alerta_temp",
        "type": "function",
        "z": "049787f649ebff4d",
        "name": "Evaluar alerta temperatura",
        "func": "// Siempre retorna un mensaje (OK o ALERTA) para que el widget se limpie.\nvar t = msg.payload.temperatura;\nif (t === null || t === undefined) {\n    return { payload: 'Sin datos del sensor de temperatura' };\n}\nif (t > 35) {\n    return { payload: 'ALERTA: Temperatura critica (' + t.toFixed(1) + 'C). Verificar ventilacion.' };\n}\nreturn { payload: 'OK: Temperatura en rango normal (' + t.toFixed(1) + 'C)' };",
        "outputs": 1,
        "x": 500,
        "y": 1120,
        "wires": [["txt_alerta_temp"]]
    },
