  },
  {
    "id": "fn_bomba_estado",
    "type": "function",
    "z": "flow_cultivo",
    "name": "Formatear estado bomba",
    "func": "msg.payload = (msg.payload === 'ON') ? 'ENCENDIDA' : 'APAGADA';\nmsg.style = (msg.payload === 'ENCENDIDA') ?\n    'font-size:18px;color:#2196F3;font-weight:bold' :\n    'font-size:18px;color:#9E9E9E;font-weight:bold';\nreturn msg;",
    "outputs": 1,
    "x": 380,
    "y": 340,
    "wires": [["txt_bomba_estado"]]
  },
  {
    "id": "mqtt_in_servo",
    "type": "mqtt in",
    "z": "flow_cultivo",
    "name": "cultivo/control_termico/estado",
    "topic": "cultivo/control_termico/estado",
    "qos": "0",
    "datatype": "auto",
    "broker": "mqtt_broker_config",
    "x": 150,
    "y": 400,
    "wires": [["fn_servo_estado"]]
  },
  {
    "id": "fn_servo_estado",
    "type": "function",
    "z": "flow_cultivo",
    "name": "Formatear estado servo",
    "func": "msg.payload = (msg.payload === 'ABIERTO') ? 'VENTILACIÓN ACTIVA' : 'VENTILACIÓN CERRADA';\nreturn msg;",
    "outputs": 1,
    "x": 380,
    "y": 400,
    "wires": [["txt_servo_estado"]]
  },
