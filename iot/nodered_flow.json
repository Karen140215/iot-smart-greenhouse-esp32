  {
    "id": "mqtt_in_sensores",
    "type": "mqtt in",
    "z": "flow_cultivo",
    "name": "Suscribir: cultivo/sensores",
    "topic": "cultivo/sensores",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_config",
    "x": 150,
    "y": 100,
    "wires": [["fn_parse_sensores", "fn_alerta_suelo", "fn_alerta_temp"]]
  },
  {
    "id": "fn_parse_sensores",
    "type": "function",
    "z": "flow_cultivo",
    "name": "Distribuir datos de sensores",
    "func": "// Extraer cada campo del JSON y distribuirlo a los widgets\nvar payload = msg.payload;\n\n// Temperatura\nflow.set('temperatura', payload.temperatura);\nnode.send([{\n    payload: payload.temperatura,\n    topic: 'temperatura'\n}, {\n    payload: payload.humedad_aire,\n    topic: 'humedad_aire'\n}, {\n    payload: payload.humedad_sustrato,\n    topic: 'humedad_sustrato'\n}, {\n    payload: payload.bomba_riego === 'ON' ? true : false,\n    topic: 'bomba'\n}, {\n    payload: payload.control_termico === 'ON' ? true : false,\n    topic: 'servo'\n}, {\n    payload: payload.modo,\n    topic: 'modo'\n}]);\nreturn null;",
    "outputs": 0,
    "x": 420,
    "y": 100,
    "wires": []
  },
