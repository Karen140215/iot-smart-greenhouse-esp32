    {
        "id": "fn_gate_riego",
        "type": "function",
        "z": "049787f649ebff4d",
        "name": "Gate: solo en MANUAL",
        "func": "// Bloquea comandos de bomba si el sistema esta en modo AUTO.\n// El ESP32 tambien los rechaza, pero este gate da feedback visual inmediato.\nvar modo = flow.get('modo') || 'AUTO';\nif (modo !== 'MANUAL') {\n    node.warn('[GATE] Bomba bloqueada: sistema en modo ' + modo + '. Cambia a MANUAL primero.');\n    return null;\n}\nreturn msg;",
        "outputs": 1,
        "x": 440,
        "y": 730,
        "wires": [["mqtt_out_riego"]]
    },
