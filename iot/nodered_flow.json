  {
    "id": "fn_heartbeat",
    "type": "function",
    "z": "flow_cultivo",
    "name": "Procesar heartbeat",
    "func": "var p = msg.payload;\nvar uptime = p.uptime_s || 0;\nvar horas = Math.floor(uptime / 3600);\nvar min   = Math.floor((uptime % 3600) / 60);\nvar seg   = uptime % 60;\nmsg.payload = 'ESP32 EN LÍNEA | IP: ' + p.ip +\n              ' | Uptime: ' + horas + 'h ' + min + 'm ' + seg + 's' +\n              ' | FW: ' + p.firmware;\nreturn msg;",
    "outputs": 1,
    "x": 380,
    "y": 520,
    "wires": [["txt_sistema_online"]]
  },
