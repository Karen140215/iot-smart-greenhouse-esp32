    {
        "id": "fn_modo_context",
        "type": "function",
        "z": "049787f649ebff4d",
        "name": "Actualizar modo en contexto",
        "func": "// Guarda el modo en contexto para que los gates de control lo lean.\nflow.set('modo', msg.payload);\n// Formatea el texto para el widget del dashboard.\nif (msg.payload === 'AUTO') {\n    msg.payload = 'AUTOMATICO - Sistema controlando riego y temperatura';\n} else {\n    msg.payload = 'MANUAL - Control desde Node-RED activo';\n}\nreturn msg;",
        "outputs": 1,
        "x": 470,
        "y": 460,
        "wires": [["txt_modo_estado"]]
    },
    {
        "id": "mqtt_in_heartbeat",
        "type": "mqtt in",
        "z": "049787f649ebff4d",
        "name": "cultivo/heartbeat",
        "topic": "cultivo/heartbeat",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "inputs": 0,
        "x": 230,
        "y": 520,
        "wires": [["fn_heartbeat"]]
    },
    {
        "id": "fn_heartbeat",
        "type": "function",
        "z": "049787f649ebff4d",
        "name": "Procesar heartbeat",
        "func": "var p = msg.payload;\nvar uptime = p.uptime_s || 0;\nvar horas = Math.floor(uptime / 3600);\nvar min   = Math.floor((uptime % 3600) / 60);\nvar seg   = uptime % 60;\nmsg.payload = 'ESP32 EN LINEA | IP: ' + p.ip +\n              ' | Uptime: ' + horas + 'h ' + min + 'm ' + seg + 's' +\n              ' | FW: ' + p.firmware;\nreturn msg;",
        "outputs": 1,
        "x": 460,
        "y": 520,
        "wires": [["txt_sistema_online"]]
    },

